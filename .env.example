# ==============================================================================
# Multi-Agent Orchestration Platform - Environment Variables
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application Configuration ---
APP_NAME="Multi-Agent Orchestration Platform"
APP_ENV="development"                  # development | staging | production
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
HOST="0.0.0.0"
PORT=8000

# --- Security & CORS ---
# In production, specify explicit origins (comma-separated), e.g. "https://app.example.com,https://api.example.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# --- Database (PostgreSQL) - Planned Infrastructure ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="orchestrator_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme_in_production"
DATABASE_URL="postgresql+asyncpg://postgres:changeme_in_production@localhost:5432/orchestrator_db"

# --- Cache / Broker (Redis) - Planned Infrastructure ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# --- LLM Provider Selection (Phase 2.5) ---
# Active provider: openrouter | gemini | groq | mock | openai
LLM_PROVIDER="openrouter"

# --- OpenRouter (Recommended for free-tier development) ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"     # e.g., openrouter/free or meta-llama/llama-3.3-70b-instruct:free

# --- Google Gemini (Free tier available) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"        # e.g., gemini-2.5-flash or gemini-1.5-flash

# --- Groq (Free tier available) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"   # e.g., llama-3.3-70b-versatile or llama3-8b-8192

# --- OpenAI (Optional legacy provider) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"


# --- Agent Settings (Phase 2) ---
AGENT_MAX_ITERATIONS=5

# --- Tool Settings (Phase 2) ---
TOOL_HTTP_TIMEOUT=10.0
TOOL_HTTP_MAX_SIZE_BYTES=100000
ALLOWED_HTTP_DOMAINS="httpbin.org,api.github.com"

