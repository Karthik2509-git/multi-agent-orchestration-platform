# ==============================================================================
# Multi-Agent Orchestration Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit production .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="Multi-Agent Orchestration Platform"
APP_ENV="development"                  # development | staging | production
APP_VERSION="0.1.0"
DEBUG=false                            # Set to false in production
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Security & CORS Settings
# ------------------------------------------------------------------------------
# In production, provide an explicit comma-separated list of approved frontend origins:
# e.g., "https://app.example.com,https://api.example.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 3. Database & Checkpointing Backend (PostgreSQL)
# ------------------------------------------------------------------------------
# CHECKPOINT_BACKEND selects LangGraph state persistence:
#   - "postgres": Durable production persistence using AsyncPostgresSaver
#   - "memory": Ephemeral in-memory persistence for unit/integration testing
CHECKPOINT_BACKEND="postgres"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="orchestrator_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme_in_production"
DATABASE_URL="postgresql+asyncpg://postgres:changeme_in_production@localhost:5432/orchestrator_db"

# ------------------------------------------------------------------------------
# 4. Cache & Broker (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 5. Multi-Provider LLM Configuration (Phases 2 & 2.5)
# ------------------------------------------------------------------------------
# Active provider: openrouter | gemini | groq | mock | openai
LLM_PROVIDER="openrouter"

# OpenRouter (Recommended for development; provides access to free & open models)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# Google Gemini (Direct API access)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Groq (Ultra-low latency inference)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI (Direct API access)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional legacy keys
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Agent Orchestration Controls (Phases 2 & 3)
# ------------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=5

# ------------------------------------------------------------------------------
# 7. Tool Execution Budgets, Failure Isolation & Guardrails (Phase 7 Milestone 3)
# ------------------------------------------------------------------------------
TOOL_HTTP_TIMEOUT=10.0
TOOL_HTTP_MAX_SIZE_BYTES=100000
ALLOWED_HTTP_DOMAINS="httpbin.org,api.github.com"
MAX_TOOL_CALLS_PER_RUN=10              # Global budget per orchestration run
TOOL_FAILURE_DISABLE_THRESHOLD=3       # Consecutive failures before run-scoped disable
TOOL_MAX_INPUT_SIZE_BYTES=65536        # Maximum JSON argument payload (64 KB)
TOOL_MAX_OUTPUT_SIZE_BYTES=1000000     # Maximum tool result payload (1 MB)

# ------------------------------------------------------------------------------
# 8. Model Context Protocol (MCP) Ecosystem (Phase 4)
# ------------------------------------------------------------------------------
MCP_ENABLED=false
MCP_LOCAL_SERVER_ENABLED=true
MCP_LOCAL_SERVER_NAME="local"
MCP_ALLOWED_TOOLS="mcp.local.calculator,mcp.local.text_stats"

# ------------------------------------------------------------------------------
# 9. RAG & Knowledge System (Phase 5)
# ------------------------------------------------------------------------------
RAG_ENABLED=true
RAG_PERSIST_DIRECTORY="./data/chroma"  # In Docker: /app/data/chroma
RAG_COLLECTION_NAME="knowledge_base"
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=5
RAG_HYBRID_ALPHA=0.6                   # 0.0 = Pure BM25, 1.0 = Pure Dense vector, 0.6 = Balanced RRF
RAG_EMBEDDING_PROVIDER="local"         # local | mock | openai
RAG_MAX_FILE_SIZE_BYTES=10000000       # 10 MB maximum upload size

# ------------------------------------------------------------------------------
# 10. Long-Term Semantic Memory (Phase 6)
# ------------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_PERSIST_DIRECTORY="./data/chroma_memory"  # In Docker: /app/data/chroma_memory
MEMORY_COLLECTION_NAME="agent_memory"
MEMORY_DEFAULT_TOP_K=3
MEMORY_SIMILARITY_THRESHOLD=0.0
MEMORY_CONSOLIDATION_THRESHOLD=0.90    # Semantic cosine threshold for deduplication
MEMORY_DEFAULT_TTL_SECONDS=""          # Optional TTL in seconds (empty = indefinite)

# ------------------------------------------------------------------------------
# 11. Human-in-the-Loop (HITL) Workflow (Phase 6)
# ------------------------------------------------------------------------------
HITL_ENABLED=true
HITL_CONFIDENCE_THRESHOLD=0.65         # Route to human review if supervisor confidence < threshold
HITL_MAX_SPECIALIST_RETRIES=2

# ------------------------------------------------------------------------------
# 12. Observability & OpenTelemetry (Phase 7 Milestones 1 & 2)
# ------------------------------------------------------------------------------
TELEMETRY_ENABLED=true
TELEMETRY_SERVICE_NAME="multi-agent-orchestrator"
TELEMETRY_EXPORTER="memory"            # memory | console | none
TELEMETRY_RECORD_PAYLOADS=false        # FORCED to false in production for safety
TELEMETRY_MAX_IN_MEMORY_SPANS=500
